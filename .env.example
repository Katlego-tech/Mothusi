# Copy to .env and fill in. .env is never committed; the gate blocks it.
# One line per key the project needs, with where to get it. `./hack env` makes .env from this
# file; a key whose line follows the comment "./hack env: generate" gets a random value.

# Local services from docker-compose.yml. If 5432, 5672, 15672 or 11434 is taken on this
# machine, change the MOTHUSI_*_PORT value; the URLs below follow it.
POSTGRES_USER=mothusi
POSTGRES_DB=mothusi
# ./hack env: generate
POSTGRES_PASSWORD=
MOTHUSI_DB_PORT=5432
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${MOTHUSI_DB_PORT}/${POSTGRES_DB}

RABBITMQ_USER=mothusi
# ./hack env: generate
RABBITMQ_PASSWORD=
MOTHUSI_AMQP_PORT=5672
MOTHUSI_RABBIT_UI_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${MOTHUSI_AMQP_PORT}/

MOTHUSI_OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:${MOTHUSI_OLLAMA_PORT}
# Models per role on Ollama (llm-seam.md §11.2, ADR 0001). On AWS, OLLAMA_URL is the G4dn's private address.
MOTHUSI_OLLAMA_MODEL=qwen3:14b
MOTHUSI_OLLAMA_MODERATOR_MODEL=phi4
MOTHUSI_OLLAMA_READER_MODEL=qwen3-vl:8b-instruct
# Optional second Ollama asked when the first fails (the laptop, when OLLAMA_URL is the G4dn).
OLLAMA_FALLBACK_URL=

# Claude API key for the Marker and Moderator (https://platform.claude.com/settings/keys). Leave it
# blank to run only the offline tests and the replay provider.
ANTHROPIC_API_KEY=
# Teacher sign-in on AWS (deployment-aws.md §6.5). Leave unset locally: auth is then off.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# The knowledge service (knowledge.md §6.7), e.g. http://localhost:8001 when it runs on the laptop.
# Blank: catch-up plans carry no passage citations, and practice tests cannot be set.
KNOWLEDGE_URL=
# The ElevenLabs voice colleague (voice-colleague.md §6, ADR 0003). Katlego decides its scope during
# testing. The key and the agent id come from the ElevenLabs dashboard. Blank: the voice is
# unavailable (GET /voice/session answers 503). On AWS the key is the secret mothusi/elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Learner note links (outputs-and-delivery.md §6.2): the key that signs them and the https base
# their QR codes point at. On AWS both come from deployment-aws.md §6.4.
# ./hack env: generate
MOTHUSI_NOTE_KEY=
MOTHUSI_PUBLIC_URL=https://localhost
MOTHUSI_NOTE_LINK_DAYS=14
